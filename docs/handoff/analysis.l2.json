        "source": "\"\"\"A tiny sample exercising the interesting v2 shapes across L1-L4.\"\"\"\n\n\nclass BaseService:\n    pass\n\n\nclass Service(BaseService):\n    def announce(self, flag):\n        message = build(flag)\n        if flag:\n            message = message + \"!\"\n        return message\n\n\ndef build(x):\n    y = x\n    return y\n\n\ndef run(flag):\n    svc = Service()\n    return svc.announce(flag)\n",
